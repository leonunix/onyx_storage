# Sequential 32K write, no rate cap. Big-block sequential is the easiest
# pattern for the backend (max coalesce / max compression / fewest meta ops).
[global]
name=onyx-seq-32k-write
ioengine=libaio
direct=1
thread=1
group_reporting=1
time_based=1
runtime=__RUNTIME__
filename=__FILENAME__
size=__SIZE__

rw=write
bs=32k
numjobs=__JOBS__
iodepth=__IODEPTH__
iodepth_batch_submit=__IODEPTH__
iodepth_batch_complete_min=1
# Spread sequential streams across the volume so concurrent jobs don't
# all write the same offset. Volume is 320 GiB / 8 jobs = 40 GiB / stream.
offset_increment=40g
__FIO_CPUS__

verify=0
serialize_overlap=1
exitall_on_error=1
continue_on_error=none

refill_buffers=1
scramble_buffers=0
dedupe_percentage=__DEDUPE_PERCENTAGE__
dedupe_mode=working_set
dedupe_global=1
dedupe_working_set_percentage=__DEDUPE_WORKING_SET_PERCENTAGE__
buffer_compress_percentage=__BUFFER_COMPRESS_PERCENTAGE__
buffer_compress_chunk=__BUFFER_COMPRESS_CHUNK__

randrepeat=0
random_generator=tausworthe64

[mixed]
