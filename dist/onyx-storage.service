[Unit]
Description=Onyx Storage Engine
Documentation=https://github.com/anthropics/onyx-storage
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/onyx-storage --config /etc/onyx-storage/config.toml start
ExecStop=/usr/local/bin/onyx-storage --config /etc/onyx-storage/config.toml stop
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# `stop` blocks until the engine has drained the LV2 ring, which on a deep ring
# is minutes of work (~1300 entries/s; a full ring is ~15 min). systemd's default
# 90 s would SIGKILL mid-drain and hand the backlog to the next start's replay —
# exactly the failure the progress-gated drain exists to avoid. A genuinely stuck
# drain still self-terminates via engine.shutdown_drain_stall_timeout_ms, so this
# only covers the healthy-but-slow case.
TimeoutStopSec=1800

# Resource limits
LimitNOFILE=1048576
LimitMEMLOCK=infinity

# ublk requires CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN

# Logging — override with systemctl edit
Environment=RUST_LOG=onyx_storage=info

# Hardening
ProtectSystem=strict
ReadWritePaths=/var/lib/onyx-storage /var/run /etc/onyx-storage /dev
PrivateTmp=yes
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
